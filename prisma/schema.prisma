generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sets          FlashcardSet[]
  cardProgress  CardProgress[]
  testHistories TestHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ─────────────────────────────────────────────────────────────

model FlashcardSet {
  id          String      @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String?
  cards       Flashcard[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Flashcard {
  id           String         @id @default(cuid())
  setId        String
  term         String
  definition   String
  type         String         @default("vocabulary")
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  set          FlashcardSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  cardProgress CardProgress[]

  @@index([setId])
}

model CardProgress {
  id              String    @id @default(cuid())
  deviceId        String
  cardId          String
  setId           String
  rememberedCount Int       @default(0)
  srsInterval     Int       @default(0)
  srsDue          DateTime  @default(now())
  srsEase         Float     @default(2.5)
  srsLapses       Int       @default(0)
  srsState        String    @default("new")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String?
  card            Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deviceId, cardId])
  @@index([setId, deviceId])
  @@index([deviceId])
  @@index([deviceId, srsDue])
  @@index([userId])
  @@index([userId, srsDue])
}

model TestHistory {
  id              String        @id @default(cuid())
  deviceId        String
  source          String        @default("prompt")
  setId           String?
  title           String
  description     String
  sections        Json
  contextHashes   Json?
  questionItemMap Json?
  createdAt       DateTime      @default(now())
  userId          String?
  attempts        TestAttempt[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([setId])
  @@index([createdAt])
  @@index([userId])
}

model TestAttempt {
  id             String      @id @default(cuid())
  testHistoryId  String
  deviceId       String
  answers        Json
  results        Json
  totalCorrect   Int
  totalQuestions Int
  createdAt      DateTime    @default(now())
  testHistory    TestHistory @relation(fields: [testHistoryId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([testHistoryId])
}

model DictionaryEntry {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  text      String
  from      String
  to        String
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([text])
}

model TtsCache {
  id          String   @id @default(cuid())
  text        String
  lang        String
  audioBase64 String
  createdAt   DateTime @default(now())

  @@unique([text, lang])
  @@index([text])
}
